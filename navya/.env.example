# Copy to .env (git-ignored) and fill in. Generate values with:  openssl rand -hex 24
DB_PASSWORD=
JWT_SECRET=
# Set SEED=true once to create demo members and listings. SEED_PASSWORD (8+ characters) is the password for all demo accounts.
SEED=false
SEED_PASSWORD=
# Optional: creates a moderator account on start
ADMIN_EMAIL=
ADMIN_PASSWORD=
